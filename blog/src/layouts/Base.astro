---
// Kerangka baru: head + header + isi + footer.
// Tidak memakai global.css lama, jadi halaman lama tidak terganggu.
import '@fontsource-variable/nunito';
import '@fontsource-variable/fraunces';
import '../styles/tokens.css';
import '../styles/base.css';
import type { ImageMetadata } from 'astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata; // hanya ditampilkan jika diisi (tidak ada gambar placeholder)
}

const { title, description, image } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<!-- Hapus data-theme="light" untuk melihat tema gelap bawaan tokens.css -->
<html lang="id" data-theme="light">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="canonical" href={canonicalURL} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{image && <meta property="og:image" content={new URL(image.src, Astro.url)} />}
	</head>
	<body>
		<SiteHeader />
		<main>
			<slot />
		</main>
		<SiteFooter />
	</body>
</html>

<style>
	main {
		padding: var(--space-12) var(--space-6);
	}
</style>